{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "es2023",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2023", "dom", "dom.iterable"],
        "types": ["vite/client"],
        "strict": true,
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false,
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.js"]
}
